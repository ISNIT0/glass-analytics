  "sql": [
    "WITH ev AS (\n  SELECT e.*,\n    CASE WHEN e.user_id IS NOT NULL AND e.user_id <> '' THEN e.user_id ELSE COALESCE(i.person_id, e.person_id) END AS pid\n  FROM events e\n  LEFT JOIN (\n    SELECT distinct_id, MIN(person_id) AS person_id\n    FROM identities\n    WHERE project = 'demo'\n    GROUP BY distinct_id\n  ) i ON i.distinct_id = e.distinct_id\n  WHERE e.project = 'demo'\n    AND e.ts_ms >= 1791282509851\n    AND e.ts_ms < 1793960909851\n    AND e.event IN ('$pageview', 'signup_completed')\n),\ns1 AS (\n  SELECT pid, MIN(ts_ms) AS t1\n  FROM ev\n  WHERE event = '$pageview' AND ts_ms < 1793874509851 AND 1 = 1\n  GROUP BY pid\n),\nb AS (\n  SELECT s1.pid, MIN(COALESCE(NULLIF(ev.utm_source, ''), '(none)')) AS bd\n  FROM s1 JOIN ev ON ev.pid = s1.pid AND ev.ts_ms = s1.t1\n  WHERE ev.event = '$pageview' AND 1 = 1\n  GROUP BY s1.pid\n),\ns2 AS (\n  SELECT s1.pid, s1.t1, MIN(ev.ts_ms) AS t2\n  FROM s1 JOIN ev ON ev.pid = s1.pid\n  WHERE ev.event = 'signup_completed'\n    AND ev.ts_ms > s1.t1\n    AND ev.ts_ms <= s1.t1 + 86400000\n    AND 1 = 1\n  GROUP BY s1.pid, s1.t1\n)\nSELECT 1 AS step, COALESCE(b.bd, '(none)') AS bd, COUNT(*) AS n, 0 AS dt_ms FROM s1 LEFT JOIN b ON b.pid = s1.pid GROUP BY COALESCE(b.bd, '(none)')\nUNION ALL\nSELECT 2 AS step, COALESCE(b.bd, '(none)') AS bd, COUNT(*) AS n, SUM(s2.t2 - s2.t1) AS dt_ms FROM s2 LEFT JOIN b ON b.pid = s2.pid GROUP BY COALESCE(b.bd, '(none)')"
  ],
