    "WITH ev AS (\n  SELECT e.*,\n    CASE WHEN e.user_id IS NOT NULL AND e.user_id <> '' THEN e.user_id ELSE COALESCE(i.person_id, e.person_id) END AS pid\n  FROM events e\n  LEFT JOIN (\n    SELECT distinct_id, MIN(person_id) AS person_id\n    FROM identities\n    WHERE project = 'demo'\n    GROUP BY distinct_id\n  ) i ON i.distinct_id = e.distinct_id\n  WHERE e.project = 'demo'\n    AND e.ts_ms >= 1786050453227\n    AND e.ts_ms < 1793826513227\n)\nSELECT event, ts_ms, path, session_id, props FROM ev WHERE pid = 'user_1575' OR distinct_id = 'user_1575'\nORDER BY ts_ms DESC LIMIT 100"
