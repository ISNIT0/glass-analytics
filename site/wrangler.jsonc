// The public site, served as Workers static assets (requests to static assets are free).
// Built by `pnpm site:build` into ./dist; deployed only by .github/workflows/deploy.yml.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "glass-site",
  "compatibility_date": "2026-10-01",
  // Served at dataflare.dev (www too); the zone is in the same Cloudflare account.
  "routes": [
    { "pattern": "dataflare.dev", "custom_domain": true },
    { "pattern": "www.dataflare.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
